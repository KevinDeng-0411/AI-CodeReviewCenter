# Application (local-first; FastAPI binds to loopback in documented commands)
APP_NAME=codeaware

# LLM (DeepSeek, OpenAI 兼容 API)
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Ollama (本地 embedding, bge-m3 1024 维)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# PostgreSQL 16 + pgvector (docker-compose 映射 5433)
PG_HOST=localhost
PG_PORT=5433
PG_USER=aicenter
PG_PASSWORD=aicenter123
PG_DB=ai_center_py

# Redis 7 (docker-compose 映射 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Short-term memory / incremental summary
MEM_WINDOW_SIZE=20
MEM_SUMMARY_THRESHOLD=10
MEM_SUMMARY_INTERVAL=5
MEM_SUMMARY_BATCH_SIZE=20
MEM_SUMMARY_MAX_CHARS=12000

# Knowledge multipart upload (5 MiB raw / 200k parsed characters)
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880
KNOWLEDGE_PARSED_MAX_CHARS=200000

# AIReadMe local snapshot (fail-closed by default).
# Enable only after setting absolute server-side roots as a JSON array.
AI_README_SNAPSHOT_ENABLED=false
LOCAL_PROJECT_ROOTS=[]
AI_README_SNAPSHOT_MAX_FILES=200
AI_README_SNAPSHOT_MAX_FILE_BYTES=262144
AI_README_SNAPSHOT_MAX_TOTAL_BYTES=2097152
AI_README_SNAPSHOT_MAX_PROMPT_CHARS=60000
AI_README_SNAPSHOT_TIMEOUT_SECONDS=5
