{
  "components": {
    "schemas": {
      "AiReadmeRequest": {
        "properties": {
          "project_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Project Name",
            "type": "string"
          },
          "project_path": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Project Path",
            "type": "string"
          }
        },
        "required": [
          "project_name",
          "project_path"
        ],
        "title": "AiReadmeRequest",
        "type": "object"
      },
      "Body_upload_file_api_knowledge_upload_file_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "PDF/DOCX/HTML/Markdown/TXT，原始文件最大 5 MiB",
            "title": "File",
            "type": "string"
          },
          "project_name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Name"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_file_api_knowledge_upload_file_post",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponseVO": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "memory_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Summary"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ChatWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "conversation_id",
          "reply"
        ],
        "title": "ChatResponseVO",
        "type": "object"
      },
      "ChatWarning": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "component": {
            "enum": [
              "message_cache",
              "summary_cache",
              "memory_recall",
              "rag_retrieval",
              "summary",
              "memory_extraction"
            ],
            "title": "Component",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "component",
          "code",
          "message",
          "retryable"
        ],
        "title": "ChatWarning",
        "type": "object"
      },
      "CodeReviewRequest": {
        "properties": {
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "project_name": {
            "title": "Project Name",
            "type": "string"
          },
          "prompt_template_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Template Id"
          },
          "source_code": {
            "title": "Source Code",
            "type": "string"
          }
        },
        "required": [
          "project_name",
          "file_path",
          "source_code"
        ],
        "title": "CodeReviewRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KnowledgeSearchRequest": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "KnowledgeSearchRequest",
        "type": "object"
      },
      "KnowledgeUploadRequest": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "project_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Name"
          },
          "source_type": {
            "default": "MANUAL",
            "title": "Source Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "KnowledgeUploadRequest",
        "type": "object"
      },
      "MemorySaveRequest": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "memory_type": {
            "default": "KNOWLEDGE",
            "title": "Memory Type",
            "type": "string"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "required": [
          "content"
        ],
        "title": "MemorySaveRequest",
        "type": "object"
      },
      "Result": {
        "properties": {
          "code": {
            "default": 1,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "msg": {
            "default": "success",
            "title": "Msg",
            "type": "string"
          }
        },
        "title": "Result",
        "type": "object"
      },
      "Result_ChatResponseVO_": {
        "properties": {
          "code": {
            "default": 1,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatResponseVO"
              },
              {
                "type": "null"
              }
            ]
          },
          "msg": {
            "default": "success",
            "title": "Msg",
            "type": "string"
          }
        },
        "title": "Result[ChatResponseVO]",
        "type": "object"
      },
      "Result_NoneType_": {
        "properties": {
          "code": {
            "default": 1,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "title": "Data",
            "type": "null"
          },
          "msg": {
            "default": "success",
            "title": "Msg",
            "type": "string"
          }
        },
        "title": "Result[NoneType]",
        "type": "object"
      },
      "UnitTestRequest": {
        "properties": {
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "project_name": {
            "title": "Project Name",
            "type": "string"
          },
          "source_code": {
            "title": "Source Code",
            "type": "string"
          },
          "test_framework": {
            "default": "JUnit5",
            "title": "Test Framework",
            "type": "string"
          }
        },
        "required": [
          "project_name",
          "file_path",
          "source_code"
        ],
        "title": "UnitTestRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
