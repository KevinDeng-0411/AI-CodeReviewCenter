    "/api/chat/send": {
      "post": {
        "description": "同步对话：drain TurnCoordinator -> ChatResponseVO。",
        "operationId": "send_api_chat_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result_ChatResponseVO_"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_CONVERSATION_NOT_FOUND"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "conversation_id 不存在"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_TURN_IN_PROGRESS"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "同一会话已有 turn 正在执行"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_REQUEST_INVALID"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "请求字段校验失败"
          },
          "500": {
            "content": {
              "application/json": {
                "examples": {
                  "CHAT_START_FAILED": {
                    "summary": "CHAT_START_FAILED",
                    "value": {
                      "code": 0,
                      "msg": "CHAT_START_FAILED"
                    }
                  },
                  "CONTEXT_FAILED": {
                    "summary": "CONTEXT_FAILED",
                    "value": {
                      "code": 0,
                      "msg": "CONTEXT_FAILED"
                    }
                  },
                  "MODEL_STREAM_FAILED": {
                    "summary": "MODEL_STREAM_FAILED",
                    "value": {
                      "code": 0,
                      "msg": "MODEL_STREAM_FAILED"
                    }
                  },
                  "PERSIST_FAILED": {
                    "summary": "PERSIST_FAILED",
                    "value": {
                      "code": 0,
                      "msg": "PERSIST_FAILED"
                    }
                  },
                  "POST_TURN_FAILED": {
                    "summary": "POST_TURN_FAILED",
                    "value": {
                      "code": 0,
                      "msg": "POST_TURN_FAILED"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "初始化失败或同步 Chat 核心失败"
          }
        },
        "summary": "Send",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/chat/send/stream": {
      "post": {
        "description": "流式对话：typed SSE。",
        "operationId": "send_stream_api_chat_send_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "版本化 typed SSE Chat 事件流"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_CONVERSATION_NOT_FOUND"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "conversation_id 不存在"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_TURN_IN_PROGRESS"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "同一会话已有 turn 正在执行"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_REQUEST_INVALID"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "请求字段校验失败"
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "CHAT_START_FAILED"
                },
                "schema": {
                  "$ref": "#/components/schemas/Result_NoneType_"
                }
              }
            },
            "description": "SSE 响应建立前 Transaction A 初始化失败"
          }
        },
        "summary": "Send Stream",
        "tags": [
          "Chat"
        ]
      }
    },
